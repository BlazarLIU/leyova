# Leyova Nova 环境变量（示例，复制为 .env）
# 单实例部署：一个客户一套环境，无 tenant_id

# 数据库（必填）
DATABASE_URL=postgresql://leyova@127.0.0.1:55432/leyova_ai_ops

# HTTP
AI_OPS_PORT=8790
AI_OPS_HOST=0.0.0.0

# 会话与加密（生产必填 32 字节以上随机值）
SESSION_SECRET=dev-only-change-me
ENCRYPTION_KEY=dev-only-change-me

# 短信（dev 模式打印到日志；prod 接服务商）
SMS_PROVIDER=dev

# 模型网关（私有化三模式之一：api / gateway / none）
AI_MODE=none
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_MODEL_DEFAULT=deepseek-chat
AI_MAX_TOKENS_PER_RUN=60000

# 文件存储（dev 用本地目录）
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/files

# 日志
LOG_LEVEL=info
