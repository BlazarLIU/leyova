# ==============================================================================
# Leyova 生产单客户独立实例配置模板 (.env.example)
#
# 部署前请复制为 .env 并生成强随机密钥（推荐：openssl rand -hex 32）
# 仓库不预置任何默认管理员密码与大模型凭据；首次启动后请通过 /setup 初始化超管账号，
# 并在「系统配置与 AI → AI 模型」中自行填配大模型。
# ==============================================================================

# ---- 运行模式与功能范围 ----
NODE_ENV=production
FEATURE_SCOPE=core
PORT=8788
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5513

# ---- 对外暴露端口（Docker Compose 可选调整） ----
POSTGRES_PORT=5432
API_PORT=8788
WEB_PORT=5513

# ---- PostgreSQL 数据库配置 ----
DB_USER=leyova
DB_PASSWORD=replace-with-strong-db-password-at-least-16-chars
DB_NAME=leyova
DATABASE_URL=postgresql://leyova:replace-with-strong-db-password-at-least-16-chars@db:5432/leyova

# ---- 首次安装凭证（留空则 API 启动时自动生成 24 小时一次性 Token 并输出至启动日志） ----
LEYOVA_SETUP_TOKEN=

# ---- 核心安全与加密密钥 (生产环境必填且长度 >= 32 字符) ----
# 会话 Cookie 签名密钥（推荐使用 openssl rand -hex 32 生成）
SESSION_SECRET=replace-with-strong-random-64-character-session-secret-salt
# 开放平台凭证与敏感字段 AES-256-GCM 主加密密钥
API_ENCRYPTION_KEY=replace-with-strong-random-64-character-api-encryption-key
# MCP (Model Context Protocol) 内部服务调用鉴权 Token
LEYOVA_MCP_TOKEN=replace-with-strong-random-64-character-mcp-token
# MCP HMAC 签名密钥（生产强制启用覆盖 uid+tenant+scope+ts 的 V2 验签）
LEYOVA_MCP_SIGNING_SECRET=replace-with-strong-random-signing-secret
LEYOVA_MCP_REQUIRE_SIG=true

# ---- AI 编排与大模型配置（可选；默认关闭，部署后也可在界面配置） ----
AI_ENABLED=false
LLM_PROTOCOL=openai
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# ---- 日志与监控 ----
LOG_LEVEL=info
