# ---- 服务基础配置 ----
NODE_ENV=development
FEATURE_SCOPE=core
PORT=8788
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5513
SESSION_COOKIE_NAME=leyova_session

# ---- 数据库连接 (PostgreSQL 14+) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leyova
# 或分项配置：
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leyova
DB_USER=postgres
DB_PASSWORD=postgres

# 测试库（仅 NODE_ENV=test 时生效，库名必须以 _test 结尾）
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leyova_test

# ---- 会话与安全密钥 ----
SESSION_SECRET=change-me-to-a-random-64-character-string-for-security-salt
# 开放平台凭证 AES-256-GCM 主密钥（>= 32 字符随机字符串，生产环境必填）
API_ENCRYPTION_KEY=replace-with-strong-random-64-char-encryption-key
# 可选：人员管理新建员工时的默认初始密码（留空则创建时需显式设置）
DEFAULT_USER_PASSWORD=

# ---- AI 助手（默认关闭；部署后可在界面「系统配置与 AI」配置，或在此填写环境变量） ----
AI_ENABLED=false
LLM_PROTOCOL=openai
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
# 外部企业知识库 REST API（如 RAGFlow / MaxKB，可选）
KNOWLEDGE_BASE_API_BASE=
KNOWLEDGE_BASE_API_KEY=
# 外部 OpenViking 记忆客户端（纯客户端接口，可选）
OPENVIKING_API_BASE=
OPENVIKING_API_KEY=

# ---- 天气 AI 穿搭与智能选品 (可选，未配置时使用气象内建拟真模型) ----
WEATHER_API_KEY=

# ---- MCP (Model Context Protocol) 协议服务 ----
# MCP Server (shared Bearer token & HMAC signing secret)
LEYOVA_MCP_TOKEN=replace-with-strong-random-mcp-token
LEYOVA_MCP_SIGNING_SECRET=replace-with-strong-random-signing-secret
LEYOVA_MCP_REQUIRE_SIG=true
# Optional fallback user ID when X-Leyova-User-Id is omitted (leave unset in production for fail-closed auth)
# LEYOVA_MCP_DEFAULT_USER_ID=
MCP_PORT=9101

# ---- Prometheus 抓取鉴权 ----
# 留空时仅允许已登录会话访问 /metrics；设置后抓取端使用
# Authorization: Bearer <METRICS_TOKEN>
METRICS_TOKEN=

# ---- 日志等级 ----
LOG_LEVEL=info

# ---- 合规风控雷达 ----
# 公开规则页自动抓取开关：on=开启（默认），off=关闭（仅保留人工录入）
# 需要执行 `pnpm exec playwright install chromium` 安装无头浏览器
COMPLIANCE_CRAWLER=on
