# ---- 服务 ----
NODE_ENV=development
PORT=8788
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:95513
SESSION_COOKIE_NAME=leyova_session

# ---- 数据库 ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leyova
DB_USER=postgres
DB_PASSWORD=change-me
# 或直接给连接串（优先）：
# DATABASE_URL=postgresql://postgres:change-me@localhost:5432/leyova

# ---- 会话 ----
SESSION_SECRET=change-me-to-a-random-64-char-string
# 可选：创建账号未填密码时的默认密码；留空则必须显式指定
DEFAULT_USER_PASSWORD=

# ---- AI 引擎（全部可选，不配置则相关功能关闭）----
AI_ENABLED=false
OPENCLAW_API_BASE=http://127.0.0.1:18789/v1
OPENCLAW_API_KEY=
OPENCLAW_MODEL=openclaw/default
OPENCLAW_TIMEOUT_MS=120000
OPENCLAW_CONFIG_PATH=
OPENCLAW_HOME=
OPENCLAW_NODE_BIN=
OPENCLAW_GATEWAY_PORT=18789
DEERFLOW_API_BASE=http://localhost:2026/api/langgraph
DEERFLOW_INTERNAL_TOKEN=
DEERFLOW_MODEL=deepseek-ai/DeepSeek-V4-Flash
DEERFLOW_TIMEOUT_MS=900000
ANYTHINGLLM_API_BASE=http://localhost:3001/api
ANYTHINGLLM_API_KEY=
OPENVIKING_API_BASE=http://localhost:1933
OPENVIKING_API_KEY=

# ---- MCP ----
LEYOVA_MCP_TOKEN=change-me
LEYOVA_MCP_DEFAULT_USER_ID=1
MCP_PORT=9101

# ---- 日志 / 定时 ----
LOG_LEVEL=info
LOG_ROOT=
CRON_AI_MODEL=
