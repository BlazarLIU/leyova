{
  "name": "@leyova/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "worker": "node --import tsx src/worker.ts",
    "test": "NODE_ENV=test FEATURE_SCOPE=full node --import tsx test/fixtures/seed.ts && NODE_ENV=test FEATURE_SCOPE=full node --import tsx --test test/*.test.ts test/governance/*.test.ts",
    "backup": "tsx src/cli/backup.ts",
    "cleanup-logs": "tsx src/cli/cleanup-logs.ts",
    "openapi:gen": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/openapi-drift.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/session": "^11.1.2",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.0.0",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^5.1.0",
    "node-cron": "^3.0.3",
    "pg": "^8.22.0",
    "pg-boss": "^10.4.2",
    "pino": "^9.5.0",
    "playwright": "^1.65.1",
    "prom-client": "^15.1.3",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.4",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3"
  }
}
